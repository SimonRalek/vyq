prm soubor = "./tests/test_io.txt";
prm obsah = "Ahoj světe!";

// Write file
prm zapsano = .zapišSoubor(.soubor; .obsah);
pokud !.zapsano: {
    tiskni "Chyba při zápisu souboru";
}

// Read file
prm precteno = .čtiSoubor(.soubor);
pokud .precteno != .obsah: {
    tiskni "Přečtený obsah neodpovídá zapsanému: " + .precteno;
}

tiskni "Test IO OK";
---
Test IO OK
